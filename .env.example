# The app works without Immich. Configure both values to enable Save to Immich.
# Use the address reachable FROM the container. localhost refers to that container.
IMMICH_URL=http://your-immich-server:2283
# Required API key permissions: asset.upload, tag.create, tag.asset.
# Saving applies "pass photo" and the selected photo-format tag, e.g. "35x45 mm".
IMMICH_API_KEY=

# Optional browser-facing Immich URL for the Open in Immich link after saving.
IMMICH_PUBLIC_URL=

# Set this when using a reverse proxy, exactly as the browser sees the app.
# Example: https://passport.home.example (no path or trailing slash needed).
PUBLIC_ORIGIN=
APP_PORT=8095
MAX_UPLOAD_BYTES=20971520
IMMICH_TIMEOUT_MS=45000
