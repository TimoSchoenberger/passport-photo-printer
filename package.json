{
  "name": "passport-photo-printer",
  "version": "1.0.2",
  "description": "A self-hosted passport photo crop and print-sheet tool with optional Immich upload.",
  "license": "MIT",
  "author": "Timo Schönberger",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TimoSchoenberger/passport-photo-printer.git"
  },
  "bugs": {
    "url": "https://github.com/TimoSchoenberger/passport-photo-printer/issues"
  },
  "homepage": "https://github.com/TimoSchoenberger/passport-photo-printer#readme",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --configLoader native --host 127.0.0.1",
    "build": "vite build --configLoader native && node scripts/verify-pwa.mjs",
    "preview": "vite preview --configLoader native --host 127.0.0.1",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "check": "svelte-check --config ./svelte.config.js --tsconfig ./jsconfig.json",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/overpass": "^5.3.0",
    "cropperjs": "1.6.2",
    "heic-to": "^1.5.2",
    "jspdf": "^4.2.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "svelte": "^5.39.0",
    "svelte-check": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^1.3.0"
  }
}
